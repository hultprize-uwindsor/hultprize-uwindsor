# Server-only settings. Put local values in .env.local; never prefix with VITE_.
# Use the same settings in Vercel's environment configuration.
# See google-apps-script/Code.gs and docs/forms.md for deployment instructions.
FORM_ENDPOINT=
# At least 32 random characters; also set FORM_SHARED_SECRET in Apps Script properties.
FORM_SHARED_SECRET=

# Event attendance uses a SEPARATE Apps Script project and spreadsheet.
# See docs/event-registration.md. Do not point this at the interest form deployment.
ATTENDANCE_ENDPOINT=
ATTENDANCE_SHARED_SECRET=
# Independent random secrets (32+ characters); server only, no VITE_ prefix.
ATTENDANCE_SESSION_SECRET=
# Passwords for trusted organisers; support role may see dietary/accessibility details.
ATTENDANCE_ADMIN_PASSWORD=
ATTENDANCE_SUPPORT_PASSWORD=
