# Server-only settings. Put local values in .env.local; never prefix with VITE_.
# Use the same settings in Vercel's environment configuration.
# See google-apps-script/Code.gs and docs/forms.md for deployment instructions.
FORM_ENDPOINT=
# At least 32 random characters; also set FORM_SHARED_SECRET in Apps Script properties.
FORM_SHARED_SECRET=
